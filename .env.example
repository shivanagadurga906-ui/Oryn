# Oryn Financial Copilot - Environment Variables Template
# Copy this file to .env.local and fill in your own API keys

# Get your Gemini API key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Stitch API Key (for Google Stitch UI generation)
VITE_STITCH_API_KEY=your_stitch_api_key_here
